# --- Base de données (Neon, Supabase, Render Postgres…) : copier l'URL fournie, le préfixe est corrigé automatiquement
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# --- Sécurité
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire        # openssl rand -hex 32
ADMIN_EMAIL=vous@exemple.com                                 # compte administrateur créé au 1er démarrage
ADMIN_PASSWORD=mot-de-passe-long-et-unique
EMAIL_SALT=autre-chaine-aleatoire                            # sel du hachage des e-mails (ne jamais changer après le début de la collecte)
# --- Tally
TALLY_FORM_ID=446dvO
TALLY_API_KEY=tly-xxxxxxxx                                   # Tally → Paramètres → API keys
TALLY_SIGNING_SECRET=xxxxxxxx                                # secret de signature du webhook (même valeur dans Tally)
# --- CORS : URL du front déployé (séparées par des virgules)
CORS_ORIGINS=https://kizuna-atlas.vercel.app,http://localhost:3000
# Pour accepter aussi les URLs de prévisualisation Vercel : CORS_ORIGIN_REGEX=https://kizuna-atlas.*\.vercel\.app
# --- Démonstration (données simulées, sans connexion) : DEMO_MODE=true
DEMO_MODE=false
